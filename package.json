{
  "name": "nodejs-intro",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 node dist/index.js",
    "dev: start": "ts-node src/index.ts",
    "build": "tsc",
    "watch": "tsc -w",
    "serve": "nodemon dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js -d src/config/database.ts",
    "migration:create": "typeorm migration:create",
    "migration:generate": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 npm run typeorm -- migration:generate",
    "migration:run": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 npm run typeorm -- migration:run",
    "migration:revert": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 npm run typeorm -- migration:revert"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "fs": "^0.0.1-security",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "nodemailer": "^7.0.3",
    "path": "^0.12.7",
    "pg": "^8.16.1",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.24",
    "uuid": "^11.1.0",
    "zod": "^3.25.32"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/node": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.15.29",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}